# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real secrets.

# development | test | production
NODE_ENV=development
PORT=5000

# Local MongoDB (what this project is set up for):
MONGODB_URI=mongodb://127.0.0.1:27017/roommates
# MongoDB Atlas instead:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/roommates?retryWrites=true&w=majority

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed to call this API. Comma-separated for more than one.
CLIENT_URL=http://localhost:5173
